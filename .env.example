# Copy to .env.local. Use local Supabase output; never commit real values.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes encoded as 64 hexadecimal characters
AI_CREDENTIAL_ENCRYPTION_KEY_V1=
AI_CREDENTIAL_ACTIVE_KEY_VERSION=1
# Set exact supported model IDs after checking provider availability
GOOGLE_ALLOWED_MODELS=
GOOGLE_DEFAULT_MODEL=
PDF_RENDER_SIGNING_SECRET=
LOG_LEVEL=info
