# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Local tools, private source CV, and generated artifacts
/.cache/
/references/*
!/references/README.md
/*.pdf
/test-results/
/playwright-report/
/playwright/.cache/
/coverage/
/.playwright-cli/
/.supabase/
# Supabase CLI local state can include development credentials and container metadata.
/supabase/.temp/
/supabase/.branches/
